{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Schedule API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Schedule",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Get Channel Stream Schedule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/schedule",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "utc_offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "first",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for forward pagination"
              }
            ]
          },
          "docs": "Gets the broadcaster's streaming schedule."
        },
        {
          "info": {
            "name": "Twitch Update Channel Stream Schedule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.twitch.tv/helix/schedule",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "is_vacation_enabled",
                "value": "",
                "type": "query"
              },
              {
                "name": "vacation_start_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "vacation_end_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "timezone",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Updates the broadcaster's streaming schedule settings."
        }
      ]
    }
  ],
  "bundled": true
}