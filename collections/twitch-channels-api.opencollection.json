{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Channels API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Channels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Get Channel Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/channels",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query",
                "description": "The ID of the broadcaster"
              }
            ]
          },
          "docs": "Gets information about one or more channels."
        },
        {
          "info": {
            "name": "Twitch Modify Channel Information",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.twitch.tv/helix/channels",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query",
                "description": "The ID of the broadcaster"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a channel's properties."
        },
        {
          "info": {
            "name": "Twitch Get Channel Editors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/channels/editors",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Gets a list of users who are editors for the specified channel."
        },
        {
          "info": {
            "name": "Twitch Get Channel Followers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/channels/followers",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query",
                "description": "Filter by specific follower user ID"
              },
              {
                "name": "first",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for forward pagination"
              }
            ]
          },
          "docs": "Gets a list of users that follow the specified broadcaster."
        }
      ]
    }
  ],
  "bundled": true
}