{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Raids API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Raids",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Start a Raid",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.twitch.tv/helix/raids",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "from_broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "to_broadcaster_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Raid another channel by sending the broadcaster's viewers to the target."
        },
        {
          "info": {
            "name": "Twitch Cancel a Raid",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.twitch.tv/helix/raids",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Cancel a pending raid."
        }
      ]
    }
  ],
  "bundled": true
}