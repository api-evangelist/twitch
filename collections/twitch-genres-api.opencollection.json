{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Genres API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Genres",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Query Genres",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.twitch.tv/helix/genres",
            "headers": [
              {
                "name": "Client-ID",
                "value": ""
              }
            ]
          },
          "docs": "Query game genres using Apicalypse query language."
        }
      ]
    }
  ],
  "bundled": true
}