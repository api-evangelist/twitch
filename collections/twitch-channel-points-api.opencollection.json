{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Channel Points API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Channel Points",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Get Custom Reward",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/channel_points/custom_rewards",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "only_manageable_rewards",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Gets a list of custom rewards for the specified broadcaster."
        },
        {
          "info": {
            "name": "Twitch Create Custom Rewards",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.twitch.tv/helix/channel_points/custom_rewards",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a custom reward for the specified broadcaster."
        }
      ]
    }
  ],
  "bundled": true
}