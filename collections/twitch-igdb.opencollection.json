      "info": {
        "name": "Games",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Query Games",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.igdb.com/v4/games",
            "headers": [
              {
                "name": "Client-ID",
                "value": ""
              }
            ]
          },
          "docs": "Query the games endpoint using Apicalypse query language. Send the query as the request body in plain text format."
        },
        {
          "info": {
            "name": "Twitch Count Games",
