{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch IGDB API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
