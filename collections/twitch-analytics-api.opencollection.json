{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Analytics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Get Game Analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/analytics/games",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "game_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "started_at",
                "value": "",
                "type": "query"
              },
              {
                "name": "ended_at",
                "value": "",
                "type": "query"
              },
              {
                "name": "first",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Gets an analytics report for one or more games including Drops data."
        }
      ]
    }
  ],
  "bundled": true
}