{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twitch Drops Ads Clips API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://id.twitch.tv/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Clips",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Twitch Get Clips",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twitch.tv/helix/clips",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "game_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "started_at",
                "value": "",
                "type": "query"
              },
              {
                "name": "ended_at",
                "value": "",
                "type": "query"
              },
              {
                "name": "first",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor for forward pagination"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor for backward pagination"
              }
            ]
          },
          "docs": "Gets one or more video clips by clip ID, broadcaster, or game."
        },
        {
          "info": {
            "name": "Twitch Create Clip",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.twitch.tv/helix/clips",
            "headers": [
              {
                "name": "Client-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "broadcaster_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "has_delay",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Creates a clip from the broadcaster's stream."
        }
      ]
    }
  ],
  "bundled": true
}